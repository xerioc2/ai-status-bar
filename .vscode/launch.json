{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run AI Status Bar",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "noDebug": true,
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "--disable-extensions"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    },
    {
      "name": "Debug AI Status Bar",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "stopOnEntry": false,
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "--disable-extensions"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    }
  ]
}
